import { Theme } from "theme.slint";

export component EntryTile inherits Rectangle {
    in property <string> name;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    width: 108px;
    height: 104px;
    border-radius: Theme.tile-radius;
    background: touch.pressed ? Theme.tile-pressed
        : (selected ? Theme.tile-selected
        : (touch.has-hover ? Theme.tile-hover : transparent));

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 8px;
        spacing: 8px;
        alignment: center;

        Image {
            source: icon;
            width: 40px;
            height: 40px;
            image-fit: contain;
            horizontal-alignment: center;
        }

        Text {
            text: name;
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            height: 32px;
            width: 96px;
        }
    }
}
