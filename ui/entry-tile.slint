import { Theme } from "theme.slint";

export component EntryTile inherits Rectangle {
    in property <string> name;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    background: transparent;
    clip: true;

    highlight := Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: Theme.tile-radius;
        background: touch.pressed ? Theme.tile-pressed
            : (selected ? Theme.tile-selected
            : (touch.has-hover ? Theme.tile-hover : transparent));

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 6px;

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                alignment: center;
                Image {
                    source: icon;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }
            }

            Text {
                text: name;
                color: Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
