import { Theme } from "theme.slint";
import { EntryTile } from "entry-tile.slint";

export struct TileData {
    id: string,
    name: string,
    icon: image,
}

export component LauncherWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    preferred-width: 760px;
    preferred-height: 540px;
    min-width: 650px;
    min-height: 450px;
    max-width: 850px;
    max-height: 650px;
    background: transparent;
    default-font-family: "Segoe UI Variable";
    default-font-size: 14px;
    icon: @image-url("assets/tray.svg");

    in-out property <[TileData]> tiles: [];
    in-out property <string> query: "";
    in-out property <int> selected-index: 0;
    in-out property <int> columns: 6;
    in-out property <bool> request-focus: false;
    in-out property <string> toast-text: "";
    in-out property <bool> toast-visible: false;
    in-out property <bool> empty: false;

    private property <length> content-pad: 20px;
    private property <length> inner-w: scroller.width > 1px ? scroller.width : max(1px, root.width - content-pad * 2);
    private property <length> cell-w: columns > 0 ? inner-w / columns : 120px;
    private property <length> cell-h: 104px;
    private property <int> row-count: columns <= 0 || tiles.length == 0 ? 0 : floor((tiles.length + columns - 1) / columns);

    function tile-col(index: int) -> int {
        if root.columns <= 0 { return 0; }
        return mod(index, root.columns);
    }

    function tile-row(index: int) -> int {
        if root.columns <= 0 { return 0; }
        return floor(index / root.columns);
    }

    callback query-changed(string);
    callback execute-selected();
    callback execute-id(string);
    callback hide-requested();
    callback focus-lost();
    callback move-left();
    callback move-right();
    callback move-up();
    callback move-down();
    callback width-changed(length);

    changed width => {
        root.width-changed(root.width);
    }

    changed request-focus => {
        if request-focus {
            focus-timer.running = false;
            focus-timer.running = true;
            request-focus = false;
        }
    }

    focus-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            search-input.focus();
            self.running = false;
        }
    }

    blur-timer := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            self.running = false;
            if !keys.has-focus {
                root.focus-lost();
            }
        }
    }

    changed selected-index => {
        ensure-visible(selected-index);
    }

    function ensure-visible(index: int) {
        if columns <= 0 || index < 0 { return; }
        let row = tile-row(index);
        let y = row * root.cell-h;
        if y < scroller.viewport-y {
            scroller.viewport-y = y;
        }
        if y + root.cell-h > scroller.viewport-y + scroller.height {
            scroller.viewport-y = max(0px, y + root.cell-h - scroller.height);
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.search-border;
        drop-shadow-blur: 28px;
        drop-shadow-color: #000000.with-alpha(0.28);
        drop-shadow-offset-y: 8px;
        clip: true;

        keys := FocusScope {
            width: 100%;
            height: 100%;

            changed has-focus => {
                if self.has-focus {
                    blur-timer.running = false;
                } else {
                    blur-timer.running = true;
                }
            }

            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    root.hide-requested();
                    return accept;
                }
                if event.text == Key.Return {
                    root.execute-selected();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-up();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-down();
                    return accept;
                }
                if event.text == Key.LeftArrow {
                    root.move-left();
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.move-right();
                    return accept;
                }
                reject
            }

            VerticalLayout {
                padding: root.content-pad;
                spacing: 16px;
                width: parent.width;
                height: parent.height;

                search-box := Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: Theme.search-bg;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.search-border;
                    clip: true;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        VerticalLayout {
                            width: 16px;
                            alignment: center;
                            Image {
                                source: @image-url("assets/search.svg");
                                width: 16px;
                                height: 16px;
                            }
                        }

                        input-area := Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            Text {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                text: "Search";
                                color: Theme.muted;
                                font-size: 16px;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                visible: search-input.text == "";
                            }

                            search-input := TextInput {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                text <=> root.query;
                                font-size: 16px;
                                color: Theme.text;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                single-line: true;
                                edited => {
                                    root.query-changed(self.text);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    scroller := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: max(self.height, root.row-count * root.cell-h);

                        GridLayout {
                            x: 0;
                            y: 0;
                            width: scroller.viewport-width;
                            height: root.row-count * root.cell-h;
                            spacing: 0px;
                            padding: 0px;

                            for tile[i] in root.tiles : EntryTile {
                                row: tile-row(i);
                                col: tile-col(i);
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                height: root.cell-h;
                                name: tile.name;
                                icon: tile.icon;
                                selected: i == root.selected-index;
                                clicked => {
                                    root.execute-id(tile.id);
                                }
                            }
                        }
                    }

                    if root.empty : Text {
                        width: 100%;
                        height: 100%;
                        text: "No results";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.toast-visible : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(parent.width - 48px, toast-label.preferred-width + 32px);
        height: 36px;
        border-radius: 8px;
        background: Theme.toast-bg;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000.with-alpha(0.2);

        toast-label := Text {
            text: root.toast-text;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 13px;
        }
    }
}
